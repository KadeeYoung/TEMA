{
  "route_name": "TEMA_SFT",
  "use_time_tokens": false,
  "use_ate": false,
  "model": "${MODEL}",
  "model_type": "qwen2_5_omni_sft_no_time_tokens_no_ate",
  "template": "qwen2_5_omni",
  "custom_register_path": "${CUSTOM_REGISTER_PATH}",
  "callbacks": [
    "sft_state"
  ],
  "torch_dtype": "bfloat16",
  "attn_impl": "flash_attn",
  "deepspeed": "${DEEPSPEED}",
  "tuner_type": "lora",
  "temporal_init_adapter_config": "${TEMPORAL_INIT_ADAPTER_CONFIG}",
  "init_from_temporal_init": "${INIT_FROM_TEMPORAL_INIT}",
  "temporal_init_extra": "${TEMPORAL_INIT_EXTRA}",
  "allow_temporal_init_token_bootstrap": false,
  "ignore_data_skip": true,
  "dataset": "${DATASET}",
  "val_dataset": null,
  "output_dir": "${OUTPUT_DIR}",
  "reports_dir": "${REPORTS_DIR}",
  "max_length": 6144,
  "packing": false,
  "padding_free": false,
  "lazy_tokenize": true,
  "loss_scale": "default",
  "per_device_train_batch_size": 2,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 6,
  "num_train_epochs": 1,
  "learning_rate": 1e-05,
  "weight_decay": 0.0,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  "max_grad_norm": 1.0,
  "gradient_checkpointing": true,
  "bf16": true,
  "tf32": true,
  "logging_steps": 5,
  "eval_steps": 1000,
  "save_steps": 100,
  "save_total_limit": 4,
  "dataloader_num_workers": 4,
  "dataset_num_proc": 8,
  "sft_lr_lora": 1e-05,
  "sft_lr_projector_lora": 5e-06,
  "sft_lr_ate": 0.0,
  "sft_lr_time_rows": 0.0,
  "row_guard_steps": 1,
  "lora_rank": 64,
  "lora_alpha": 128,
  "lora_dropout": 0.05
}
