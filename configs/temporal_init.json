{
  "experiment_id": "TEMA_TEMPORAL_INIT",
  "tc_enabled": false,
  "lambda_rank_max": 0.0,
  "rank_warmup_ratio": 0.1,
  "use_time_tokens": false,
  "use_ate": false,
  "expected_global_batch": 48,
  "model": "${MODEL}",
  "model_type": "qwen2_5_omni_temporal_init_no_time_tokens_no_ate",
  "template": "qwen2_5_omni",
  "custom_register_path": "${CUSTOM_REGISTER_PATH}",
  "callbacks": [
    "temporal_init_state"
  ],
  "dataset": "${DATASET}",
  "val_dataset": "${VAL_DATASET}",
  "split_dataset_ratio": 0,
  "remove_unused_columns": false,
  "strict": true,
  "lazy_tokenize": true,
  "tuner_type": "lora",
  "lora_rank": 64,
  "lora_alpha": 128,
  "lora_dropout": 0.05,
  "target_modules": [
    "all-linear"
  ],
  "target_regex": "^(thinker.model.*\\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)|thinker.audio_tower.proj|thinker.visual.merger.*\\.(0|2))$",
  "freeze_vit": true,
  "freeze_aligner": false,
  "torch_dtype": "bfloat16",
  "bf16": true,
  "tf32": true,
  "attn_impl": "flash_attn",
  "max_length": 640,
  "truncation_strategy": "left",
  "packing": false,
  "padding_free": false,
  "loss_scale": "default",
  "use_logits_to_keep": false,
  "per_device_train_batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 2,
  "num_train_epochs": 1,
  "max_steps": 1867,
  "learning_rate": 1e-05,
  "weight_decay": 0.1,
  "optim": "adamw_torch",
  "optimizer": "temporal_init",
  "lr_scheduler_type": "cosine",
  "warmup_ratio": 0.03,
  "max_grad_norm": 1.0,
  "gradient_checkpointing": true,
  "gradient_checkpointing_kwargs": {
    "use_reentrant": false
  },
  "seed": 42,
  "data_seed": 42,
  "full_determinism": false,
  "dataloader_drop_last": false,
  "dataloader_num_workers": 8,
  "dataloader_prefetch_factor": 4,
  "dataloader_persistent_workers": false,
  "dataloader_pin_memory": true,
  "dataset_num_proc": 1,
  "logging_steps": 20,
  "eval_strategy": "steps",
  "eval_steps": 1867,
  "save_strategy": "steps",
  "save_steps": 1867,
  "save_total_limit": 1,
  "report_to": [
    "tensorboard"
  ],
  "output_dir": "${OUTPUT_DIR}",
  "llm_lora_lr": 1e-05,
  "projector_lora_lr": 1e-05,
  "new_token_lr": 0.0,
  "ate_lr": 0.0,
  "negative_seed": 20260903
}
